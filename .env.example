# Site URL (used for Polar checkout redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Postgres) — Project Settings > API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Upstash Redis — caches leaderboard reads so they don't hit Postgres on
# every request. Create a database at https://console.upstash.com and copy
# the REST credentials (Vercel's Upstash integration sets these for you).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Creem.io Payment Integration
CREEM_API_KEY=
CREEM_WEBHOOK_SECRET=
NEXT_PUBLIC_CREEM_PRODUCT_ID=

# Umami analytics (https://umami.is)
# Leave unset to disable analytics entirely.
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
# Only needed for a self-hosted Umami instance; defaults to Umami Cloud.
NEXT_PUBLIC_UMAMI_SCRIPT_URL=

# Mode Toggle: Set "true" for 100% Free Mode, or "false" for Paid Indexing Mode.
NEXT_PUBLIC_IS_FREE_MODE=true
